<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the game-independent bundle logic (file parsing, rules, stats, parry math) against the
    game's own types from assembly_valheim.dll, outside the game. Anything that needs a live
    Unity engine (ObjectDB, StatusEffect assets, Harmony patches) is tested in-game; see README.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The game assemblies target .NET Framework; they load fine for plain data classes. -->
    <NoWarn>$(NoWarn);NU1701;MSB3277</NoWarn>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../src/Catalog.cs" />
    <Compile Include="../src/ParryAssist.cs" />
    <Compile Include="../src/Bundles/BundleFile.cs" />
    <Compile Include="../src/Bundles/BundleRules.cs" />
    <Compile Include="../src/Bundles/BundleStats.cs" />
    <EmbeddedResource Include="../example/LoadoutBuffs.bundles.yaml" LogicalName="LoadoutBuffs.bundles.example.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
